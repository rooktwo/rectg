---
import Icon from './Icon.astro';
import { getAvatarColorClass, getTelegramUsername, itemPath } from '../utils/data';
export interface Props { id: string; title: string; desc: string; url: string; typeName: string; countStr: string; category: string }
const { id, title, desc, url, typeName, countStr, category } = Astro.props;
const username = getTelegramUsername(url);
const firstLetter = Array.from(title || '?')[0].toUpperCase();
const countLabel = typeName === '群组' ? '成员' : '订阅';
---
<article class="card" data-id={id} data-type={typeName}>
  <div class="card-header">
    <div class={`card-icon ${getAvatarColorClass(firstLetter)}`} aria-hidden="true">
      <span class="avatar-letter">{firstLetter}</span>
      {username && <img src={`https://unavatar.io/telegram/${username}`} width="42" height="42" loading="lazy" decoding="async" alt="" onerror="this.hidden=true" />}
    </div>
    <div class="card-title-wrap">
      <a href={itemPath(id)} class="card-title" title={title}>{title}</a>
      <div class="card-meta"><span class="card-type">{typeName}</span><span aria-hidden="true">·</span><span class="card-category">{category}</span></div>
    </div>
    <button class="icon-button bookmark-button" type="button" data-bookmark={id} aria-label={`收藏 ${title}`} aria-pressed="false" title="收藏"><Icon name="bookmark" size={17} /></button>
  </div>
  <p class="card-desc">{desc || '暂无简介，前往 Telegram 了解更多。'}</p>
  <div class="card-footer">
    <span class="resource-count"><strong>{countStr || '—'}</strong><span>{countLabel}</span></span>
    <div class="card-actions">
      <button class="icon-button card-copy-btn" type="button" aria-label={`复制 ${title} 的链接`} title="复制链接" data-copy-url={url}><Icon name="copy" size={15} /><span class="copy-label sr-only">复制链接</span></button>
      <a class="card-action-primary" href={url} target="_blank" rel="noopener noreferrer" aria-label={`在 Telegram 打开 ${title}`}>Telegram <Icon name="external" size={15} /></a>
    </div>
  </div>
</article>
