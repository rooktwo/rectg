---
import Card from './Card.astro';
import Icon from './Icon.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { buildDirectoryData, categoryPath } from '../utils/data';

const { activeId = 'featured' } = Astro.props;
const { validSections, featuredItems, totalItems, typeStats } = buildDirectoryData();
const sections = validSections.map(({ meta, items }) => ({ ...meta, items }));
const active = sections.find(section => section.id === activeId);
const initialItems = active?.items || featuredItems;
const typeNames = ['频道', '群组'];
if (typeStats.some(stat => stat.name === '机器人')) typeNames.push('机器人');
const payload = JSON.stringify({ sections, featuredIds: featuredItems.map(item => item.id) }).replace(/</g, '\\u003c');
---
<SiteHeader directory />
<div id="app" class="directory-layout">
  <aside id="sidebar" aria-labelledby="nav-title">
    <div class="sidebar-heading">
      <h2 id="nav-title">主题分类</h2><span>{sections.length}</span>
      <button id="close-sidebar-btn" class="icon-button" type="button" aria-label="关闭分类菜单"><Icon name="close" /></button>
    </div>
    <nav id="category-nav" aria-labelledby="nav-title">
      <div class="nav-group">
        <a class:list={['nav-item', { active: !active }]} data-section="featured" href="/" aria-current={!active ? 'page' : undefined}><Icon name="compass" size={17} /><span>目录摘选</span></a>
        <a class="nav-item" data-section="all" href="/?c=all"><Icon name="grid" size={17} /><span>全部收录</span><span class="nav-count">{totalItems}</span></a>
      </div>
      {sections.map(section => (
        <a class:list={['nav-item', { active: activeId === section.id }]} data-section={section.id} href={categoryPath(section.id)} aria-current={activeId === section.id ? 'page' : undefined}>
          <Icon name={section.name} size={17} /><span>{section.name}</span><span class="nav-count">{section.items.length}</span>
        </a>
      ))}
    </nav>
    <a class="drawer-submit text-link" href="https://github.com/rooktwo/rectg/issues/new?template=channel-submission.md" target="_blank" rel="noopener noreferrer"><Icon name="plus" size={16} />提交收录</a>
  </aside>
  <div id="sidebar-overlay" aria-hidden="true"></div>
  <main id="main-content">
    <header class="directory-tools">
      <form class="search-box" role="search" action="/" aria-label="搜索资源">
        <Icon name="search" size={19} />
        <label for="search-input" class="sr-only">搜索名称、简介或 t.me 地址</label>
        <input id="search-input" name="q" type="search" placeholder="搜索名称、简介或 t.me 地址" autocomplete="off" spellcheck="false" />
        <button id="clear-search-btn" class="icon-button" type="button" aria-label="清空搜索" hidden><Icon name="close" size={16} /></button>
        <kbd id="search-shortcut" aria-hidden="true">/</kbd>
        <button class="search-submit" type="submit">搜索</button>
      </form>
      <aside class="official-channel" aria-label="官方频道">
        <Icon name="radio" size={16} /><span>官方频道</span>
        <a href="https://t.me/tgtuijian" target="_blank" rel="noopener noreferrer">Telegram 频道群组推荐 <span>@tgtuijian</span><Icon name="external" size={14} /></a>
      </aside>
    </header>
    <noscript><nav class="mobile-category-strip" aria-label="浏览主题">{sections.map(section => <a href={categoryPath(section.id)}>{section.name}</a>)}</nav></noscript>
    <section id="active-section" data-current-id={activeId} aria-labelledby="active-section-title">
      <div class="section-heading directory-heading">
        <div class="result-heading">
          <h1 id="active-section-title">{active?.name || '目录摘选'}</h1>
          <span class="category-title-meta"><span id="active-section-meta">{initialItems.length}</span> 个资源</span>
        </div>
        <div class="directory-toolbar" aria-label="筛选和显示方式">
          <label class="select-control">
            <span class="sr-only">资源类型</span>
            <select id="type-select"><option value="all">全部类型</option>{typeNames.map(name => <option value={name}>{name}（{initialItems.filter(item => item.typeName === name).length}）</option>)}</select>
            <Icon name="chevron" size={12} />
          </label>
          <label class="select-control">
            <span class="sr-only">排序方式</span>
            <select id="sort-select"><option value="default">默认排序</option><option value="members">人数从多到少</option><option value="name">名称 A–Z</option></select>
            <Icon name="chevron" size={12} />
          </label>
          <div class="view-switch" role="group" aria-label="显示方式">
            <button class="icon-button" data-view="grid" type="button" aria-label="卡片视图" aria-pressed="true" title="卡片视图"><Icon name="grid" size={15} /></button>
            <button class="icon-button" data-view="list" type="button" aria-label="列表视图" aria-pressed="false" title="列表视图"><Icon name="list" size={16} /></button>
          </div>
        </div>
      </div>
      <p id="active-section-desc" class="category-description" hidden></p>
      <div id="result-status" class="result-status" hidden>
        <span id="result-status-text"></span>
        <button id="result-clear-btn" class="text-link" type="button">清除条件</button>
        <button id="search-all-btn" class="text-link" type="button" hidden>搜索全站<Icon name="arrow" size={14} /></button>
      </div>
      <p id="results-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
      <div class="grid" id="active-grid">{initialItems.map(item => <Card {...item} category={item.categoryName} />)}</div>
      <div id="empty-state" class="empty-state" hidden><Icon name="search" size={28} /><h2>没有找到相关资源</h2><p>换个关键词，或者试试其他分类。</p><button class="button secondary" type="button" id="empty-reset">清除筛选</button></div>
      <div class="load-more-wrap" id="load-more-wrap" hidden><p id="page-count"></p><button class="button secondary" id="load-more" type="button">加载更多<Icon name="plus" size={16} /></button></div>
      <p class="results-end" id="results-end">共 {initialItems.length} 个收录 · 人数仅供参考</p>
      <a id="browse-all" class="text-link browse-all" data-section="all" href="/?c=all" hidden={Boolean(active)}>浏览全部收录<Icon name="arrow" size={16} /></a>
    </section>
    <section class="directory-about" id="directory-about" hidden={Boolean(active)}><details><summary>关于这个目录<Icon name="plus" size={16} /></summary><p>rectg 整理公开的 Telegram 中文资源。你可以按主题浏览，或搜索名称、拼音、简介和 t.me 地址。收藏保存在当前浏览器中。</p></details></section>
    <SiteFooter />
  </main>
</div>
<button id="back-to-top" class="icon-button back-to-top" type="button" aria-label="返回顶部" hidden><Icon name="arrow" size={19} /></button>
<template id="card-template"><Card id="" title="" desc="" url="" typeName="" countStr="" category="" /></template>
<script id="directory-data" type="application/json" set:html={payload}></script>
<script src="../scripts/main.js"></script>
