---
import Layout from '../layouts/Layout.astro';
import Directory from '../components/Directory.astro';
import { absoluteUrl, buildDirectoryData, itemPath, SITE_URL } from '../utils/data';

const { validSections, featuredItems, totalItems } = buildDirectoryData();
const pageDescription = `收录 ${totalItems} 个 Telegram 中文频道和群组，按 ${validSections.length} 个主题分类整理，支持按名称、简介、关键词和 t.me 地址搜索。`;
const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'rectg',
    url: `${SITE_URL}/`,
    inLanguage: 'zh-CN',
    description: pageDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'rectg',
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/og-image.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE_URL}/#collection`,
    url: `${SITE_URL}/`,
    name: 'rectg Telegram 中文资源索引',
    description: pageDescription,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: {
      '@type': 'Thing',
      name: 'Telegram 中文频道和群组',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${SITE_URL}/#featured-items`,
    name: 'rectg 目录摘选资源',
    numberOfItems: featuredItems.length,
    itemListElement: featuredItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(itemPath(item.id)),
      name: item.title,
    })),
  },
];
---

<Layout description={pageDescription} jsonLd={homeJsonLd}>
  <Directory />
</Layout>
