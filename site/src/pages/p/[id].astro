---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {
  absoluteUrl,
  categoryPath,
  getAvatarColorClass,
  getItemPaths,
  getTelegramUsername,
  itemPath,
  SITE_URL,
} from '../../utils/data';

export async function getStaticPaths() {
  return getItemPaths();
}

const {
  item,
  categoryName,
  categoryFullName,
  typeName,
  previousItem = null,
  nextItem = null,
  relatedItems = [],
} = Astro.props;
const username = getTelegramUsername(item.url);
const avatarUrl = username ? `https://unavatar.io/telegram/${username}` : '';
const firstLetter = item.title ? Array.from(item.title)[0].toUpperCase() : '?';
const subscriberCount = item.countStr || '暂无数据';
const countLabel = typeName === '频道' ? '订阅' : typeName === '群组' ? '成员' : '人数';
const openLabel = typeName === '频道' ? '打开频道' : typeName === '群组' ? '打开群组' : '打开 Telegram';
const telegramLabel = username ? `@${username}` : item.url;
const pickText = (...values) =>
  values
    .map(value => (typeof value === 'string' ? value.trim() : ''))
    .find(Boolean) || '未分类';
const resolvedCategoryName = pickText(categoryName, categoryFullName, '未分类');
const resolvedCategoryFullName = pickText(categoryFullName, categoryName, '未分类');
const categoryId = item.categoryId || resolvedCategoryName;
const categoryHref = categoryPath(categoryId);
const colorClass = getAvatarColorClass(firstLetter);
const pageTitle = `${item.title} - rectg`;
const pageDescription = item.desc
  ? item.desc.slice(0, 120)
  : `${item.title} 的基本信息、所属分类和 Telegram 入口。`;
const detailPath = itemPath(item.id);
const detailUrl = absoluteUrl(detailPath);
const detailJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': detailUrl,
    url: detailUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: resolvedCategoryName,
        item: absoluteUrl(categoryHref),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: item.title,
        item: detailUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Thing',
    '@id': `${detailUrl}#resource`,
    name: item.title,
    description: item.desc || pageDescription,
    url: item.url,
    sameAs: item.url,
    mainEntityOfPage: detailUrl,
    additionalProperty: [
      { '@type': 'PropertyValue', name: '类型', value: typeName },
      { '@type': 'PropertyValue', name: '分类', value: resolvedCategoryName },
      { '@type': 'PropertyValue', name: '人数', value: subscriberCount },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${detailUrl}#related`,
    name: `${resolvedCategoryName}同分类资源`,
    numberOfItems: relatedItems.length,
    itemListElement: relatedItems.map((related, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(itemPath(related.id)),
      name: related.title,
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath={detailPath} ogType="article" jsonLd={detailJsonLd}>
  <div id="detail-app" class="detail-page">
    <SiteHeader />
    <main id="main-content" class="detail-container">
      <nav class="breadcrumb" aria-label="面包屑"><a href="/">目录</a><Icon name="chevron" size={13} /><a href={categoryHref}>{resolvedCategoryName}</a><Icon name="chevron" size={13} /><span aria-current="page">资源详情</span></nav>
      <a class="back-link text-link" data-back-directory href={categoryHref}><span aria-hidden="true">←</span> 返回浏览</a>
      <div class="detail-grid">
        <article class="resource-card" data-id={item.id} data-type={typeName}>
          <header class="resource-header">
            <div class={`resource-avatar ${colorClass}`} aria-hidden="true"><span>{firstLetter}</span>{avatarUrl && <img src={avatarUrl} alt="" width="72" height="72" decoding="async" onerror="this.hidden=true" />}</div>
            <div class="resource-identity"><p class="eyebrow">{typeName}<span> / </span><a href={categoryHref}>{resolvedCategoryName}</a></p><h1>{item.title}</h1><p class="resource-username">{telegramLabel}</p></div>
          </header>
          <div class="detail-actions" aria-label="资源操作">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="button action-primary"><Icon name="telegram" size={18} />{openLabel}<Icon name="external" size={16} /></a>
            <button type="button" class="button secondary" data-copy-url={item.url}><Icon name="copy" size={17} />复制链接</button>
            <button type="button" class="button secondary bookmark-button" data-bookmark={item.id} data-title={item.title} aria-pressed="false"><Icon name="bookmark" size={17} /><span class="bookmark-label">收藏</span></button>
          </div>
          <section class="resource-copy" aria-labelledby="description-heading"><h2 id="description-heading">关于这个{typeName}</h2><p class="resource-description">{item.desc || '暂无简介，可以前往 Telegram 查看更多信息。'}</p></section>
          <div class="resource-footnote"><span>信息来自公开页面，可能已发生变化。</span><a href={`https://github.com/jackvale/rectg/issues/new?title=${encodeURIComponent(`资源反馈：${item.title}`)}&body=${encodeURIComponent(`资源链接：${item.url}\n\n问题说明：`)}`} target="_blank" rel="noopener noreferrer">反馈问题 ↗</a></div>
        </article>
        <aside class="resource-aside" aria-labelledby="info-heading"><h2 id="info-heading">收录信息</h2><dl class="resource-info"><div><dt>{countLabel}人数</dt><dd class="info-count">{subscriberCount}</dd></div><div><dt>类型</dt><dd>{typeName}</dd></div><div><dt>所属主题</dt><dd><a href={categoryHref}>{resolvedCategoryName}<Icon name="external" size={14} /></a></dd></div><div><dt>Telegram 地址</dt><dd><a class="telegram-link" href={item.url} target="_blank" rel="noopener noreferrer">{telegramLabel}<Icon name="external" size={14} /></a></dd></div></dl><p>人数为收录时的参考值，请以 Telegram 内的实际信息为准。</p></aside>
      </div>
      {relatedItems.length > 0 && <section class="related-section" aria-labelledby="related-title"><div class="section-heading"><h2 id="related-title">继续逛逛{resolvedCategoryName}</h2><a class="text-link" href={categoryHref}>查看分类<Icon name="arrow" size={16} /></a></div><div class="related-list">{relatedItems.map(related => <a class="related-item" href={itemPath(related.id)}><span class={`related-avatar ${getAvatarColorClass(Array.from(related.title)[0])}`} aria-hidden="true">{Array.from(related.title)[0]}</span><span><strong>{related.title}</strong><small>{related.typeName} · {related.countStr} 人</small></span><Icon name="arrow" size={18} /></a>)}</div></section>}
      <nav class="resource-pagination" aria-label="同分类前后资源">{previousItem ? <a href={itemPath(previousItem.id)}><span>← 上一个</span><strong>{previousItem.title}</strong></a> : <span></span>}{nextItem ? <a href={itemPath(nextItem.id)}><span>下一个 →</span><strong>{nextItem.title}</strong></a> : <span></span>}</nav>
      <SiteFooter compact />
    </main>
  </div>
</Layout>
