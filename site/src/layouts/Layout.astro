---
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  robots?: string;
  jsonLd?: unknown | unknown[];
}

const SITE_URL = 'https://www.rectg.com';
const {
  title = 'Telegram 中文目录 - rectg',
  description = '整理公开的 Telegram 中文频道和群组，支持分类浏览、关键词搜索、详情查看和 Telegram 链接。',
  canonicalPath = '/',
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  jsonLd,
} = Astro.props as Props;
const canonicalUrl = new URL(canonicalPath, SITE_URL).href;
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'rectg',
  url: `${SITE_URL}/`,
  description: 'Telegram 中文频道与群组公开目录',
};
const structuredData = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [defaultJsonLd];
const jsonLdContent = JSON.stringify(structuredData.length === 1 ? structuredData[0] : structuredData);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content="Telegram, TG群组, TG频道, 电报群, 电报导航, telegram中文, telegram频道, telegram群组" />
  <meta name="author" content="rectg" />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={robots} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="rectg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="zh_CN" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalUrl} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#f8f9f6" id="theme-color-meta" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={jsonLdContent}></script>

</head>
<body>
  <script is:inline>
    // Prevent FOUC (Flash of Unstyled Content) by setting theme immediately
    (function() {
      try {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.body.classList.add('dark');
        } else {
          document.body.classList.remove('dark');
        }
        document.getElementById('theme-color-meta')?.setAttribute(
          'content',
          document.body.classList.contains('dark') ? '#171c19' : '#f8f9f6',
        );
      } catch (e) {}
    })();
  </script>
  <noscript>
    <div class="noscript-notice">
      未启用 JavaScript。你仍可浏览资源；搜索、筛选和收藏需启用后使用。
    </div>
  </noscript>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <slot />
  <div id="toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
  <script src="../scripts/shared.js"></script>
  <script src="../scripts/metrics.js"></script>
  <script>
    // Register Service Worker
    const browserNavigator = window.navigator;
    if (import.meta.env.PROD && browserNavigator && 'serviceWorker' in browserNavigator) {
      window.addEventListener('load', () => {
        browserNavigator.serviceWorker.register('/sw.js').catch(registrationError => {
          console.warn('SW registration failed: ', registrationError);
        });
      });
    }
  </script>
</body>
</html>
